# ====================================================================
# Nepal CEE Result Checker - Environment Variables Template
# ====================================================================

# Application
APP_NAME="CEE Result Checker Nepal"
APP_VERSION="1.0.0"
DEBUG=True

# Supabase PostgreSQL Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Security & Authentication
JWT_SECRET="generate-a-strong-64-character-secret-key-for-production-here"
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_PASSWORD="Admin@CEE2024"

# Rate Limiting
SEARCH_RATE_LIMIT_PER_MINUTE=60

# OCR & File Limits
MAX_UPLOAD_SIZE_MB=50
TESSERACT_CMD="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
